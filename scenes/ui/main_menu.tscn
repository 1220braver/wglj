[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Bg" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.05, 0.05, 0.1, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_right = 0.5
offset_left = -120
offset_top = -80
offset_right = 120
offset_bottom = 80
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="VBox"]
text = "五关六将"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 48
theme_override_colors/font_color = Color(0.9, 0.8, 0.5, 1)

[node name="Subtitle" type="Label" parent="VBox"]
text = "v0.1 Demo"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.6, 0.6, 0.6, 1)

[node name="Spacer" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 20)

[node name="StartBtn" type="Button" parent="VBox"]
text = "Start Game"
theme_override_font_sizes/font_size = 24

[node name="QuitBtn" type="Button" parent="VBox"]
text = "Quit"
theme_override_font_sizes/font_size = 24

[connection signal="pressed" from="VBox/StartBtn" to="." method="_on_start_pressed"]
[connection signal="pressed" from="VBox/QuitBtn" to="." method="_on_quit_pressed"]
